# Normalize text; keep diffs readable for humans and agents.
* text=auto eol=lf

*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.neon text eol=lf

# Generated / binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.mo binary
*.zip binary
*.phar binary

# Do not linguist-count lockfiles as code.
package-lock.json linguist-generated=true
composer.lock linguist-generated=true
