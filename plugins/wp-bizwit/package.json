{
  "name": "wp-bizwit",
  "version": "0.3.0",
  "private": true,
  "description": "Business administration for Indonesian companies and UMKM — clients, projects, invoices and payment receipts inside wp-admin.",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.8",
    "@wordpress/env": "^11.7.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:analyze": "vue-tsc --noEmit && ANALYZE=1 vite build",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build:assets": "vite build",
    "preview": "vite preview",
    "lint": "composer run phpcs",
    "phpcs": "composer run phpcs",
    "phpstan": "composer run phpstan",
    "composer:install": "composer install --prefer-dist --no-interaction",
    "test": "npm run test:unit",
    "env:start": "wp-env start --update",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:cli": "wp-env run cli --env-cwd=wp-content/plugins/wp-bizwit",
    "test:unit": "vitest run",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wp-bizwit bash -lc 'composer install --working-dir=tests --no-interaction && vendor/bin/phpunit'"
  },
  "dependencies": {
    "vue": "^3.5.40"
  }
}
