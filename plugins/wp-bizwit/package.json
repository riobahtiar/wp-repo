{
  "name": "wp-bizwit",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.8",
    "@wordpress/env": "^11.7.0",
    "@wordpress/scripts": "^32.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.8"
  },
  "scripts": {
    "dev": "vite",
    "prebuild:clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "vue-tsc --noEmit && npm run prebuild:clean && npm run build:legacy && vite build",
    "typecheck": "vue-tsc --noEmit",
    "build:assets": "vite build",
    "preview": "vite preview",
    "start:legacy": "wp-scripts start --blocks-manifest",
    "build:legacy": "wp-scripts build --blocks-manifest",
    "lint:style": "wp-scripts lint-style 'resources/**/*.{css,scss,sass}'",
    "lint:js": "wp-scripts lint-js ./resources",
    "lint:fix:js": "wp-scripts lint-js ./resources --fix",
    "lint:fix:style": "wp-scripts lint-style 'resources/**/*.{css,scss,sass}' --fix",
    "format": "wp-scripts format ./resources",
    "packages-update": "wp-scripts packages-update",
    "create-block": "bash -lc \"mkdir -p src/Blocks && cd src/Blocks && npx @wordpress/create-block --no-plugin --namespace=wp-bizwit --textdomain=wp-bizwit\"",
    "env:start": "wp-env start --update",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:cli": "wp-env run cli --env-cwd=wp-content/plugins/wp-bizwit",
    "test:unit": "vitest run",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wp-bizwit bash -lc 'composer install --working-dir=tests --no-interaction && vendor/bin/phpunit'"
  },
  "dependencies": {
    "vue": "^3.5.40"
  }
}
