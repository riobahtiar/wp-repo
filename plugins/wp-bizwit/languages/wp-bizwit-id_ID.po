msgid "WP BizWit"
msgstr "WP BizWit"

#. Description of the plugin
#: wp-bizwit.php
msgid "WordPress Plugins for Business and Administration. Manage clients, projects, invoices and payment records. Record keeping only, no payment processing."
msgstr "Plugin WordPress untuk Bisnis dan Administrasi. Kelola klien, proyek, faktur, dan catatan pembayaran. Hanya pencatatan, tanpa pemrosesan pembayaran."

