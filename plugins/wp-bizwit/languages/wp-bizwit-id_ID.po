#: src/Admin/Screens/Invoices_Screen.php:50
msgid "Issue invoices against a client or project, and keep a record of what has been billed."
msgstr "Terbitkan faktur untuk klien atau proyek, dan simpan catatan apa saja yang sudah ditagihkan."

#: src/Admin/Screens/Invoices_Screen.php:60
msgid "Line items with quantity, unit price, per-line tax and discounts."
msgstr "Rincian item dengan kuantitas, harga satuan, pajak per baris, dan diskon."

#: src/Admin/Screens/Invoices_Screen.php:61
msgid "Race-free invoice numbering in your chosen format."
msgstr "Penomoran faktur bebas tabrakan sesuai format yang Anda pilih."

#: src/Admin/Screens/Invoices_Screen.php:62
msgid "Draft, sent, partially paid, paid, overdue and void statuses."
msgstr "Status draf, terkirim, dibayar sebagian, lunas, jatuh tempo, dan batal."

#: src/Admin/Screens/Invoices_Screen.php:63
msgid "Print-ready invoice output, with the running balance shown against payments."
msgstr "Tampilan faktur siap cetak, lengkap dengan sisa tagihan terhadap pembayaran yang masuk."

#: src/Admin/Screens/Invoices_Screen.php:73
msgid "PPN hanya dicantumkan bila usaha Anda berstatus PKP."
msgstr "PPN hanya dicantumkan bila usaha Anda berstatus PKP."

#: src/Admin/Screens/Invoices_Screen.php:74
msgid "Pencatatan potongan PPh 23, sehingga nilai faktur dan dana yang diterima di rekening tetap dapat direkonsiliasi."
msgstr "Pencatatan potongan PPh 23, sehingga nilai faktur dan dana yang diterima di rekening tetap dapat direkonsiliasi."

#: src/Admin/Screens/Invoices_Screen.php:75
msgid "Penagihan bertahap: uang muka, termin, dan retensi."
msgstr "Penagihan bertahap: uang muka, termin, dan retensi."

#: src/Admin/Screens/Invoices_Screen.php:76
msgid "Rujukan nomor PO, SPK dan BAST pada faktur."
msgstr "Rujukan nomor PO, SPK dan BAST pada faktur."

#: src/Admin/Screens/Payments_Screen.php:50
msgid "Record payments that have already been received elsewhere, and issue the matching receipt."
msgstr "Catat pembayaran yang sudah diterima di tempat lain, lalu terbitkan kwitansinya."

#: src/Admin/Screens/Payments_Screen.php:60
msgid "Payments recorded against an invoice, including partial payments."
msgstr "Pembayaran dicatat terhadap faktur, termasuk pembayaran sebagian."

#: src/Admin/Screens/Payments_Screen.php:61
msgid "Sequential receipt numbering, independent of invoice numbering."
msgstr "Penomoran kwitansi berurutan, terpisah dari penomoran faktur."

#: src/Admin/Screens/Payments_Screen.php:62
msgid "Payment method and external reference, for reconciliation against a bank statement."
msgstr "Metode pembayaran dan nomor referensi, untuk rekonsiliasi dengan rekening koran."

#: src/Admin/Screens/Payments_Screen.php:66
msgid "Kwitansi dengan nilai terbilang, sebagaimana lazim pada dokumen yang ditandatangani klien."
msgstr "Kwitansi dengan nilai terbilang, sebagaimana lazim pada dokumen yang ditandatangani klien."

#: src/Admin/Screens/Payments_Screen.php:67
msgid "Pengingat bea meterai untuk kwitansi di atas ambang batas."
msgstr "Pengingat bea meterai untuk kwitansi di atas ambang batas."

#: src/Admin/Screens/Payments_Screen.php:68
msgid "Metode pembayaran lokal: transfer bank, QRIS, e-wallet, virtual account, dan SP2D untuk instansi pemerintah."
msgstr "Metode pembayaran lokal: transfer bank, QRIS, e-wallet, virtual account, dan SP2D untuk instansi pemerintah."

#: src/Admin/Screens/Payments_Screen.php:71
msgid "This plugin never processes or moves money. It records payments that happened elsewhere."
msgstr "Plugin ini tidak pernah memproses atau memindahkan uang. Yang dicatat adalah pembayaran yang terjadi di luar sistem."

