#. Plugin Name of the plugin
#: wp-bizwit.php
msgid "WP BizWit"
msgstr "WP BizWit"

#. Description of the plugin
#: wp-bizwit.php
msgid "Business administration for Indonesian companies and UMKM: clients, projects, invoices and receipts (kwitansi) with NPWP, NIB, PKP/PPN, PPh 23, terbilang and stamp duty. Record-keeping only — never processes payments."
msgstr "Administrasi bisnis untuk perusahaan dan UMKM Indonesia: klien, proyek, faktur dan kwitansi dengan NPWP, NIB, PKP/PPN, PPh 23, terbilang dan bea meterai. Hanya pencatatan — tidak memproses pembayaran."

