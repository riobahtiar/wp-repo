# npm workspaces monorepo — install only from the repository root.
# https://docs.npmjs.com/cli/v10/using-npm/workspaces

# Fail installs that would produce a broken peer graph (industry default for apps).
# Set false only if a workspace has a known peer conflict you must tolerate.
strict-peer-deps=false

# Do not create package-lock.json inside workspace packages if someone runs
# npm install inside a plugin by mistake (npm 9+). Root lockfile is canonical.
install-strategy=hoisted

# Quieter installs
fund=false
audit=false

# Engine checks: warn but don't block local PHP/host toolchains from odd Node.
engine-strict=false
